# ──────────────────────────────────────────────────────────────────────────
# Production .env template — copy to .env on the VPS and fill real values.
# For local dev, see .env.local.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database ───────────────────────────────────────────────────────────────
# Compose service hostname is `postgres`. Password must match POSTGRES_PASSWORD below.
DATABASE_URL="postgresql://icr:CHANGE_ME_STRONG_PASSWORD@postgres:5432/icr"

# ─── Auth.js v5 ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32-output-min-32-chars"
# Full URL of the app (used by Auth.js for redirect URLs)
AUTH_URL="https://inversionesicr.com"

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://inversionesicr.com"
# Used by next/image remotePatterns AND by Caddy as the TLS host
# (Caddy also auto-serves www.${PUBLIC_HOST}).
PUBLIC_HOST="inversionesicr.com"

# ─── Storage ────────────────────────────────────────────────────────────────
# Root directory for uploaded files (inside the container, mounted from host)
STORAGE_ROOT="./storage/uploads"

# ─── Seed (one-shot, used by scripts/seed.ts only) ──────────────────────────
# First ADMIN user — change the password after first login.
SEED_ADMIN_EMAIL="admin@inversionesicr.com"
# Min 12 chars, must include digit + symbol
SEED_ADMIN_PASSWORD="Change_Me_Strong_123!"

# ─── Contact / SMTP (optional, feature-gated) ───────────────────────────────
# Set CONTACT_EMAIL_ENABLED=true to activate email sending from contact form.
CONTACT_EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@inversionesicr.com"

# ─── Docker Compose ─────────────────────────────────────────────────────────
# Credentials for the postgres container. DATABASE_URL above must match.
POSTGRES_DB="icr"
POSTGRES_USER="icr"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
COMPOSE_PROJECT_NAME="inversiones-icr"
