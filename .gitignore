# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env.development.local
.env.test.local
.env.production.local
# keep .env.example committed

# uploads / storage
# Excepción deliberada: los uploads rescatados del VPS anterior sí se versionan
# porque son la única copia que queda de las imágenes reales de la tienda.
/storage/*
!/storage/uploads/

# backups de base de datos — contienen hashes de contraseña y datos personales.
# Ojo: no uses `*.sql` aquí, excluiría las migraciones de Prisma.
/backups/
*.dump

# test reports
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# local tooling caches (skill registry, etc.)
.atl/
/tmp/icr-dev/

# local-only compose overrides (e.g. expose ports, disable caddy for laptop testing)
docker-compose.override.yml
