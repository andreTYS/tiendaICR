          OUTPUT NOW
        </text>
        <text x="12" y="52" fontFamily="Space Grotesk, sans-serif" fontSize="22" fontWeight="600" fill="#FFC107">
          4.82 kW
        </text>
      </g>
      <g transform="translate(390, 60)">
        <rect width="150" height="70" rx="8" fill="#151916" stroke="#262B28" />
