# ──────────────────────────────────────────────────────────────────────────
# Plantilla para DESARROLLO LOCAL. Cópiala tal cual:
#
#   cp .env.local.example .env.local
#
# Los valores ya cuadran con `docker compose -f docker-compose.dev.yml up -d`,
# que levanta Postgres en el puerto 5433 con usuario/clave/base `icr`.
#
# No uses este fichero para producción: para eso está `.env.example`.
# ──────────────────────────────────────────────────────────────────────────

# ─── Base de datos ──────────────────────────────────────────────────────────
# El compose de desarrollo mapea 5433 en el host -> 5432 en el contenedor.
DATABASE_URL="postgresql://icr:icr@localhost:5433/icr"

# ─── Auth.js v5 ─────────────────────────────────────────────────────────────
# Valor de relleno SOLO para desarrollo (Zod exige >= 32 caracteres).
# En producción genera uno propio: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-no-usar-en-produccion-32+"
AUTH_URL="http://localhost:3000"

# ─── Sitio ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_HOST="localhost"

# ─── Almacenamiento ─────────────────────────────────────────────────────────
STORAGE_ROOT="./storage/uploads"

# ─── Seed (solo lo lee `npm run seed`) ──────────────────────────────────────
# Con estas credenciales entras en http://localhost:3000/admin
SEED_ADMIN_EMAIL="admin@localhost.dev"
SEED_ADMIN_PASSWORD="Local_Dev_1234!"

# ─── Contacto / SMTP (opcional, desactivado por defecto) ────────────────────
CONTACT_EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@localhost.dev"
